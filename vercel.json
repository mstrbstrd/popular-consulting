{
  "headers": [
    {
      "source": "/orb",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/orb/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/game",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/game/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/engineering",
      "destination": "/engineering/index.html"
    },
    {
      "source": "/engineering/:path*",
      "destination": "/engineering/index.html"
    },
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/work/:path*",
      "destination": "/work/index.html"
    },
    {
      "source": "/orb",
      "destination": "/orb/index.html"
    },
    {
      "source": "/orb/:path*",
      "destination": "/orb/index.html"
    },
    {
      "source": "/game",
      "destination": "/game/index.html"
    },
    {
      "source": "/game/:path*",
      "destination": "/game/index.html"
    }
  ]
}
