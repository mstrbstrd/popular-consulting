# Server-only configuration. Never prefix secrets with REACT_APP_.
OPENAI_API_KEY=
METABLOOM_OPENAI_MODEL=gpt-5-mini
# Optional research model with Responses web_search and reasoning support.
# Defaults to METABLOOM_OPENAI_MODEL, then gpt-5-mini. Uses OPENAI_API_KEY.
METABLOOM_RESEARCH_MODEL=
# Native visuals remain opt-in. The tool switch can disable explicit requests.
METABLOOM_VISUALS_ENABLED=false
METABLOOM_UI_TOOLS_ENABLED=true
# Optional positive integer limits. Unset/empty uses 30/hour and 200/24 hours.
# Subject range: 1-1000. Deployment range: 1-10000. Invalid values fail closed.
# Existing counters/windows are retained when configuration changes.
METABLOOM_VISUAL_SUBJECT_LIMIT_PER_HOUR=30
METABLOOM_VISUAL_DEPLOYMENT_LIMIT_PER_DAY=200
# Optional Jev configuration for two-step live Orb gestures.
JEV_MODEL=jev-latest
TYPESAFE_API_KEY=
# Required for provider-backed preview/production deployments, not loopback development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
