# Server-only configuration. Never prefix secrets with REACT_APP_.
OPENAI_API_KEY=
METABLOOM_OPENAI_MODEL=gpt-5-mini
# Optional research model with Responses web_search and reasoning support.
# Defaults to METABLOOM_OPENAI_MODEL, then gpt-5-mini. Uses OPENAI_API_KEY.
METABLOOM_RESEARCH_MODEL=
# Optional Jev configuration for two-step live Orb gestures.
JEV_MODEL=jev-latest
TYPESAFE_API_KEY=
# Required for provider-backed preview/production deployments, not loopback development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
