# Server-only. Do not commit filled-in values or use REACT_APP_ prefixes.
# Keep false until all setup and live acceptance tests in orb-sms.md are complete.
ORB_SMS_ENABLED=false
ORB_SMS_ENVIRONMENT=production
# AUTH_APP_ORIGIN already belongs to site authentication. Use its canonical HTTPS origin.
# AUTH_APP_ORIGIN=https://popular-consulting.com
ORB_SMS_REDIS_REST_URL=
ORB_SMS_REDIS_REST_TOKEN=
# Generate independently with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORB_SMS_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_RELAY_NUMBER=
ORB_OWNER_NUMBER=
# Reuse an existing strong project CRON_SECRET rather than replacing it.
CRON_SECRET=
