{
  "name": "popular-consulting_react",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.15.3",
    "@vercel/functions": "3.9.8",
    "openid-client": "6.8.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node scripts/generate-route-html.mjs && node scripts/build-private-invoice.mjs",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint --ext .js src --max-warnings 0",
    "visual:reference": "npm run build && node scripts/capture-visual-reference.mjs",
    "visual:dark-evidence": "npm run build && node scripts/capture-visual-dark-evidence.mjs",
    "visual:dark-evidence:self-test": "node scripts/capture-visual-dark-evidence.mjs --self-test",
    "visual:dark-evidence:smoke": "npm run build && node scripts/capture-visual-dark-evidence.mjs --smoke --allow-software --skip-gpu-gate --skip-visual-gate --viewport=480x300",
    "visual:dark-evidence:physical": "node scripts/run-physical-dark-qualification.mjs",
    "visual:dark-evidence:physical:verify": "node scripts/verify-physical-dark-qualification.mjs",
    "test:auth": "node --test server/auth-tests/*.test.mjs",
    "lint:saved-work": "eslint --env node --max-warnings 0 server/metabloomAccountIdentity.js server/metabloomAuth.js server/metabloomSavedContent.js server/metabloomSavedWork*.js scripts/metabloom-saved-content.test.cjs scripts/metabloom-saved-work-*.cjs scripts/fixtures/metabloom-saved-work-*.cjs server/auth-tests/metabloom-account-identity.test.mjs api/metabloom-saved-work.js server/metabloomVisualStore.js src/components/metabloomSavedContent.js src/components/metabloomSavedWorkProtocol.js src/components/metabloomSavedWorkApiClient.js",
    "test:saved-work": "node --test scripts/metabloom-saved-content.test.cjs scripts/metabloom-saved-work-database.test.cjs scripts/metabloom-saved-work-store.test.cjs scripts/metabloom-saved-work-api.test.cjs scripts/metabloom-saved-work-client.test.cjs scripts/metabloom-saved-work-revisions.test.cjs",
    "test:saved-work:redis": "node --test scripts/metabloom-saved-work-redis.test.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.test.js",
          "src/testHelpers/**"
        ],
        "rules": {
          "testing-library/no-node-access": "off",
          "testing-library/no-container": "off",
          "testing-library/prefer-screen-queries": "off",
          "testing-library/no-render-in-setup": "off",
          "testing-library/no-wait-for-multiple-assertions": "off",
          "testing-library/render-result-naming-convention": "off",
          "testing-library/no-unnecessary-act": "off",
          "jest/no-conditional-expect": "off"
        }
      }
    ],
    "globals": {
      "globalThis": "readonly"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "esbuild": "0.28.2",
    "jest-axe": "^10.0.0"
  }
}
